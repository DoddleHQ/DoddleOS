{
  "name": "doddle-gtm-skills",
  "version": "2.0.0",
  "description": "Doddle GTM OS \u2014 go-to-market orchestration: 32 skills and 7 agents (strategy, positioning, ICP, demand, pipeline, enablement, pricing, advocacy, international, measurement). Deterministic Python toolkit (dgtm) computes funnel math, unit economics, pricing, market sizing, scoring and pipeline audit; skills narrate. Synced from DoddleHQ/doddle-go-to-market-skills.",
  "author": {
    "name": "Doddle Team",
    "url": "https://doddlehq.com"
  },
  "homepage": "https://doddlehq.com",
  "repository": "https://github.com/DoddleHQ/DoddleOS",
  "documentation": "https://docs.doddlehq.com",
  "license": "MIT",
  "keywords": [
    "gtm",
    "go-to-market",
    "positioning",
    "icp",
    "demand-generation",
    "pipeline",
    "pricing",
    "abm",
    "smb"
  ],
  "category": "gtm",
  "tags": [
    "gtm",
    "go-to-market",
    "sales",
    "revenue"
  ],
  "skills": "./.claude/skills",
  "agents": "./.claude/agents",
  "main": "README.md",
  "components": {
    "skills": {
      "path": "./.claude/skills",
      "count": 32,
      "ids": "doddle.gtm.*"
    },
    "agents": {
      "path": "./.claude/agents",
      "count": 7,
      "list": [
        "gtm-strategist",
        "positioning-strategist",
        "demand-gen-strategist",
        "enablement-lead",
        "revenue-analyst",
        "revenue-operations",
        "partner-manager"
      ]
    },
    "toolkit": {
      "path": "./scripts/doddle_gtm",
      "cli": "dgtm",
      "python": ">=3.9",
      "dependencies": "stdlib-only"
    }
  },
  "requirements": {
    "doddleOS": ">=2.0"
  }
}
