#!/usr/bin/env python3
"""Thin launcher so skills can call ``python3 scripts/dgtm ...`` with no PYTHONPATH setup."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from doddle_gtm.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
