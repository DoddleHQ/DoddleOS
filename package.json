{
  "name": "DoddleOS",
  "version": "1.12.0",
  "description": "DoddleOS skills distribution — validated graph blueprints (SKILL.md + blueprint.yaml) + specs for Claude Code, Cursor, and GitHub Copilot. 20 agents, 198 commands, 172 skills across 18 domain packs. Harness spec is draft in doddle-core/spec/; no runner ships in this repo.",
  "main": "CLAUDE.md",
  "scripts": {
    "test": "python3 doddle-core/scripts/validate.py",
    "lint": "python3 doddle-core/scripts/validate.py --strict",
    "semantic-release": "semantic-release",
    "prepare": "husky install || true"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DoddleHQ/DoddleOS.git"
  },
  "keywords": [
    "claude-code",
    "cursor",
    "github-copilot",
    "ai-agents",
    "marketing-automation",
    "content-marketing",
    "seo",
    "cro",
    "email-marketing",
    "campaign-management"
  ],
  "author": "Le Duc Linh <linh@doddlehq.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DoddleHQ/DoddleOS/issues"
  },
  "homepage": "https://doddlehq.com",
  "files": [
    ".claude/",
    "training/",
    "docs/",
    "plugins/",
    "assets/",
    "CLAUDE.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^18.4.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "husky": "^8.0.3",
    "semantic-release": "^22.0.12"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
